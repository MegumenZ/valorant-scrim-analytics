# Valorant Scrim Analytics Platform Environment Config

# 1. Database (Turso libSQL Cloud)
# Jika kosong di local development, otomatis fallback ke SQLite lokal di ./data/scrims.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# 2. Discord OAuth 2.0 Authentication
# Dapatkan dari Discord Developer Portal (https://discord.com/developers/applications)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/discord/callback

# 3. Security & Whitelist
# Secret key 32+ karakter untuk enkripsi session cookie JWT
AUTH_SECRET=your-random-secure-secret-key-at-least-32-chars-long

# Daftar Discord User ID yang otomatis mendapat akses ADMIN / IGL (pisahkan dengan koma)
# Contoh: 389218392183921839,492019201920192019
DISCORD_ADMIN_IDS=
